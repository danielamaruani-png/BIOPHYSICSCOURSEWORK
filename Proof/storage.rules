rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Proof photos are private to their owner for Phase 1 — friends see
    // only the completion status computed into publicProfiles, never
    // the photo itself. Revisit if a later phase adds photo sharing.
    match /proofs/{uid}/{resolutionId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
