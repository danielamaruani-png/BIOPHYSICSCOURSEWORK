rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function pairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    // Mirrors the same check in firestore.rules — a photo is readable
    // by its owner, or by someone who has an *accepted* PartnerRequest
    // with them. Plain "following" never grants this; it only ever
    // sees today's ✅/⭕ via publicProfiles.
    function isAcceptedPartner(uid, otherUid) {
      let id = pairId(uid, otherUid);
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/partnerRequests/$(id)) &&
        firestore.get(/databases/(default)/documents/partnerRequests/$(id)).data.status == 'accepted';
    }

    match /proofs/{uid}/{resolutionId}/{fileName} {
      allow read: if request.auth != null &&
        (request.auth.uid == uid || isAcceptedPartner(uid, request.auth.uid));
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
