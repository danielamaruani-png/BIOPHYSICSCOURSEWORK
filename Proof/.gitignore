# Generated by `xcodegen generate` from project.yml — regenerate rather
# than diffing, to avoid merge conflicts in the pbxproj.
Proof.xcodeproj/

# Per-developer Xcode state
xcuserdata/
*.xcuserstate
DerivedData/

# Firebase config is project-specific; each developer supplies their own
# from the Firebase console rather than committing it.
GoogleService-Info.plist

.DS_Store

# Cloud Functions
functions/node_modules/
functions/*.log
