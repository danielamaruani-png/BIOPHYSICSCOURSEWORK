{
  "name": "Proof Expo preview",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "postCreateCommand": "cd ProofExpo && npm install",
  "forwardPorts": [8081, 19000, 19001, 19002],
  "portsAttributes": {
    "8081": { "label": "Expo Metro Bundler", "onAutoForward": "notify" },
    "19000": { "label": "Expo dev server", "onAutoForward": "notify" }
  },
  "waitFor": "postCreateCommand"
}
